# ─── Database (PostgreSQL / Supabase) ───────────────────────────────────────
# Pooled connection for the app (Prisma + adapter-pg).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Local Docker (see docker-compose.yml): postgres/postgres, DB rad_dash, port 55432
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/rad_dash"

# Optional: direct (non-pooler) URL for migrations only — required for Supabase
# if DATABASE_URL points at PgBouncer in transaction mode.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ─── Auth (NextAuth v5) ─────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"
# App URL used for cookies and email links (no trailing slash)
AUTH_URL="http://localhost:3003"
# Legacy alias — optional if AUTH_URL is set
# NEXTAUTH_URL="http://localhost:3003"

# Trust host when behind Railway / Vercel / reverse proxy
AUTH_TRUST_HOST="true"

# ─── Secrets at rest (GitHub webhook tokens stored per project) ───────────────
# 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY="..."

# ─── Email (Resend in prod, or Mailpit/SMTP in dev) ───────────────────────────
# Production: set RESEND_API_KEY (real key, not re_YOUR...) and leave SMTP_HOST unset.
# Local with docker compose mailpit: SMTP_HOST=127.0.0.1 SMTP_PORT=11025 (maps to container 1025)
# Web UI: http://localhost:18025 — set SMTP_UI_PORT=18025 so logs point at the right port.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Tickets <tickets@yourdomain.com>"
# ADMIN_NOTIFICATION_EMAIL="ops@yourdomain.com"
# SMTP_HOST="127.0.0.1"
# SMTP_PORT="11025"
# SMTP_UI_PORT="18025"
# Optional: redirect all non-prod mail to one inbox (see lib/email.ts)
# DEV_EMAIL_OVERRIDE="you@example.com"

# ─── Bootstrap admin (scripts/bootstrap-admin.ts only) ────────────────────────
# BOOTSTRAP_ADMIN_EMAIL="admin@yourdomain.com"
# BOOTSTRAP_ADMIN_PASSWORD="use-a-strong-password"

# ─── Supabase storage (optional — ticket comment / field media uploads) ─────────
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."

# ─── App environment (exposed to client) ─────────────────────────────────────
# Controls DevTools visibility alongside NODE_ENV. Set to "development" locally.
# NEXT_PUBLIC_APP_ENV="development"

# ─── DevTools (optional overrides) ───────────────────────────────────────────
# Set to "true" to force-enable DevTools regardless of NODE_ENV / APP_ENV.
# DEVTOOLS_ENABLED="true"

# ─── Local dev only ───────────────────────────────────────────────────────────
# DEV_BYPASS_AUTH="true"
# DEV_USER_ROLE="ADMIN"
# Must match a real user row when set (e.g. seed): admin@rad-dash.local
# DEV_BYPASS_USER_EMAIL="admin@rad-dash.local"

# ─── Field Tracker integration ───────────────────────────────────────────────
# Shared secret used to authenticate inbound webhook calls from Field Tracker
# AND outbound status-change calls from rad-dash back to Field Tracker.
# Must match RAD_DASH_WEBHOOK_SECRET in Field Tracker's environment.
# FIELD_TRACKER_WEBHOOK_SECRET="generate-a-strong-random-secret"
#
# Base URL of the Field Tracker app (no trailing slash).
# Used for outbound status-change webhooks: POST {BASE_URL}/api/webhooks/status-change
# FIELD_TRACKER_BASE_URL="https://field-tracker.example.com"

# ─── Command Center Reboot integration (outbound webhook) ─────────────────────
# When a sprint ticket moves to IN_PROGRESS or DONE, rad-dash calls this
# endpoint to sync the corresponding ticket status in Command Center Reboot.
# Projects are linked via the commandCenterProjectId field on the Project model.
# Uses the same FIELD_TRACKER_WEBHOOK_SECRET for authentication.
#FIELD_TRACKER_WEBHOOK_SECRET="secret"
#FIELD_TRACKER_WEBHOOK_URL="localhost"

# ── Gemini API (optional) ──────────────────────────────────────────────────────
# Required for Daily Digest, DevTools AI analysis, and AI project insights.
# Get a key at aistudio.google.com.
#GOOGLE_GENERATIVE_AI_API_KEY="your-api-key"
