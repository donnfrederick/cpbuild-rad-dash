# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# local field-media uploads (dev only, not for Supabase)
/.local-field-media/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# next-pwa build artifacts (regenerated by next build — do not commit)
/public/sw.js
/public/workbox-*.js

# production
/build

# local field-media uploads (SUPABASE_SERVICE_ROLE_KEY empty)
.local-field-media/

# misc
.DS_Store
*.pem
# Cursor — ignore personal/machine settings, share project rules with the team
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
.env.deploy
# .env.example and .env.deploy.example are intentionally committed

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma
.guardian.log

# Python compiled files
__pycache__/
*.pyc
*.pyo
